        "start_time_sec": 491.84,
        "end_time_sec": 516.279
      },
      "original_proposition": "Whatever changes we make, however, when we hold down a note, the sound stays the same for the whole duration, which is kind of boring. This is where our final main section modulation comes in. Starting from the left, we first have macros. These can be assigned to control any parameter in Serum, either by drag and drop or in the modulation matrix.",
      "knowledge_type": "PROCEDURE",
      "epistemic_status": "SOURCE_REPORTED",
      "normalized_proposition": null,
      "semantic_bindings": [],
