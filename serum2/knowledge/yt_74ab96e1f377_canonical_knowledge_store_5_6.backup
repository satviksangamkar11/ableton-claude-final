    "ki_86a1ecbd6619b724": {
      "knowledge_item_id": "ki_86a1ecbd6619b724",
      "source_reference": {
        "source_id": "yt_74ab96e1f377",
        "source_type": "YOUTUBE_VIDEO",
        "source_url": null,
        "source_title": "Serum 2 for Absolute Beginners (Guide)",
        "segment_ids": [
          "seg_0106",
          "seg_0107",
          "seg_0108",
          "seg_0109",
          "seg_0110",
          "seg_0111",
          "seg_0112",
          "seg_0113",
          "seg_0114",
          "seg_0115"
        ],
        "start_time_sec": 272.479,
        "end_time_sec": 297.24
      },
      "original_proposition": "In this example, we're effectively splitting the signal into two, meaning our filters are acting on the signal in parallel with one another. In some cases, however, we might want to first send the signal entirely to one filter, and then use the filter routin tab to send this filter's output to filter two. This means our filters are now acting in series.",
      "knowledge_type": "PROCEDURE",
      "epistemic_status": "SOURCE_REPORTED",
      "normalized_proposition": null,
      "semantic_bindings": [],
      "extraction_confidence": 0.85,
