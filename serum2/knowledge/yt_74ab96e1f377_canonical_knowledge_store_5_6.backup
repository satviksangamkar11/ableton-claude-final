        ],
        "start_time_sec": 777.12,
        "end_time_sec": 832.5189999999999
      },
      "original_proposition": "You can also create new points by double clicking or even using the shape tools. There's a rate control that controls how fast the LFO repeats, which by default is synced to your host [Music] BPM, but can also be switched to the unsynced frequency mode. LFOs have three different modes. Retrig, the default, which restarts the LFO every time a new note is played. Free, which ignores incoming notes and just follows your door. And envelope mode, which means like an envelope, the LFO will only trigger once per note.",
      "knowledge_type": "EXAMPLE",
      "epistemic_status": "SOURCE_REPORTED",
      "normalized_proposition": "You can also create new points by double clicking or even using the shape tools. There's a rate control that controls how fast the LFO repeats, which by default is synced to your host BPM, but can also be switched to the unsynced frequency mode. LFOs have three different modes. Retrig, the default, which restarts the LFO every time a new note is played. Free, which ignores incoming notes and just follows your door. And envelope mode, which means like an envelope, the LFO will only trigger once per note.",
      "semantic_bindings": [],
      "extraction_confidence": 0.75,
      "ambiguity": null,
