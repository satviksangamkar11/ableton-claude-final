    "ki_9354378a8d8f5469": {
      "knowledge_item_id": "ki_9354378a8d8f5469",
      "source_reference": {
        "source_id": "yt_74ab96e1f377",
        "source_type": "YOUTUBE_VIDEO",
        "source_url": null,
        "source_title": "Serum 2 for Absolute Beginners (Guide)",
        "segment_ids": [
          "seg_0089",
          "seg_0090",
          "seg_0091",
          "seg_0092",
          "seg_0093",
