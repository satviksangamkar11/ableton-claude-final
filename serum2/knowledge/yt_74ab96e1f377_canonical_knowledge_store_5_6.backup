    "ki_2639c5858b308783": {
      "knowledge_item_id": "ki_2639c5858b308783",
      "source_reference": {
        "source_id": "yt_74ab96e1f377",
        "source_type": "YOUTUBE_VIDEO",
        "source_url": null,
        "source_title": "Serum 2 for Absolute Beginners (Guide)",
        "segment_ids": [
          "seg_0116",
          "seg_0117",
          "seg_0118",
          "seg_0119",
          "seg_0120",
          "seg_0121",
          "seg_0122",
          "seg_0123",
