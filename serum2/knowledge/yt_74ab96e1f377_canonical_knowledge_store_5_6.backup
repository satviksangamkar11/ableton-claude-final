    "ki_2d2e41e7e2d0eb86": {
      "knowledge_item_id": "ki_2d2e41e7e2d0eb86",
      "source_reference": {
        "source_id": "yt_74ab96e1f377",
        "source_type": "YOUTUBE_VIDEO",
        "source_url": null,
        "source_title": "Serum 2 for Absolute Beginners (Guide)",
        "segment_ids": [
          "seg_0138",
          "seg_0139",
          "seg_0140",
          "seg_0141",
          "seg_0142",
          "seg_0143",
          "seg_0144",
          "seg_0145",
          "seg_0146",
          "seg_0147",
          "seg_0148"
        ],
        "start_time_sec": 366.08,
        "end_time_sec": 396.56
      },
      "original_proposition": "There's a lot to cover here in future videos, but a few things to mention are that you can add new effects with the plus icon in the top left or by right-clicking anywhere in the effects page. Temporarily bypass an effect using the icon either on the effects panel or the effect itself. Most effects also have a mix control, which is a balance between the dry signal versus entirely the effect",
      "knowledge_type": "OBSERVATION",
      "epistemic_status": "SOURCE_REPORTED",
      "normalized_proposition": null,
      "semantic_bindings": [],
      "extraction_confidence": 0.75,
