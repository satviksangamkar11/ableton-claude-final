    "ki_ac8dae19f8f660ca": {
      "knowledge_item_id": "ki_ac8dae19f8f660ca",
      "source_reference": {
        "source_id": "yt_74ab96e1f377",
        "source_type": "YOUTUBE_VIDEO",
        "source_url": null,
        "source_title": "Serum 2 for Absolute Beginners (Guide)",
        "segment_ids": [
          "seg_0083",
          "seg_0084",
          "seg_0085",
          "seg_0086",
          "seg_0087",
          "seg_0088"
        ],
        "start_time_sec": 205.84,
        "end_time_sec": 222.959
      },
      "original_proposition": "Let's say we want to use a lowass filter to roll off some of the high frequencies. First, we have to make sure the audio from our wavetable oscillator is being sent to our filter. Either from the filter itself by clicking a button,",
      "knowledge_type": "EXAMPLE",
      "epistemic_status": "SOURCE_REPORTED",
